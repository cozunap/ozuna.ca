---
const { block } = Astro.props;
---

<section class="hero-section block-hero">
  {block.background && (
    <div class="hero-video-bg">
      <img src={block.background} alt={block.headline} class="hero-video-element" style="object-fit: cover; width: 100%; height: 100%;" />
    </div>
  )}
  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    {block.headline && <h2 class="hero-title">{block.headline}</h2>}
    {block.subheadline && <p class="hero-subtitle" style="color: white; font-size: 1.2rem; margin-bottom: 2rem;">{block.subheadline}</p>}
    
    {block.button && block.button.text && block.button.link && (
      <div class="hero-buttons">
        <a href={block.button.link} class="btn btn-primary btn-animated">
          {block.button.text}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .block-hero {
    position: relative;
    padding: clamp(4rem, 8vw, 7rem) 0;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
