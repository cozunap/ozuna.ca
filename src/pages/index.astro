---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../supabase.js';
import { slugify } from '../utils/slugify.js';

let projects = [];
try {
  const { data } = await supabase
    .from('portfolio_work')
    .select('*')
    .order('created_at', { ascending: false });
    
  if (data) {
    // Try to get featured first
    projects = data.filter(p => p.featured).slice(0, 3);
    // If not enough featured, fill with latest
    if (projects.length < 3) {
      const remaining = data.filter(p => !p.featured).slice(0, 3 - projects.length);
      projects = [...projects, ...remaining];
    }
  }
} catch (e) {
  console.error("Error fetching projects", e);
}

let homeData = {
  heroTitle: "Elevating Brands",
  heroSubtitle: "through Design.",
  heroDescription: "I am a graphic designer & web developer specializing in premium digital experiences, brand identity, and scalable design systems.",
  backgroundVideo: "/assets/videos/designer-working.mp4"
};
---
<Layout title="Carlos Ozuna | Premium Design Portfolio">
  
  <section class="hero-video-section">
    <div class="hero-video-bg">
      <video autoplay loop muted playsinline class="hero-video-element">
        <source src={homeData.backgroundVideo} type="video/mp4">
      </video>
    </div>
    <div class="hero-overlay"></div>
    
    <div class="container hero-content text-center">
      <h1 class="title-giant text-white">{homeData.heroTitle} <br><span style="color: var(--gold); font-style: italic;">{homeData.heroSubtitle}</span></h1>
      <p class="subtitle text-white" style="margin: 0 auto 3rem auto; opacity: 0.9;">{homeData.heroDescription}</p>
      <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="/work" class="btn btn-gold">View Portfolio</a>
        <a href="/about" class="btn btn-outline-white">About Me</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem;">
      <h2 class="title-section" style="margin: 0;">Selected Works</h2>
      <a href="/work" style="color: var(--gold); font-weight: 600; font-size: 1.1rem;">View all works &rarr;</a>
    </div>
    
    <div class="gallery-grid">
      {projects.map((project) => (
        <a href={`/work/${slugify(project.title)}`} class="gallery-card">
          <div class="gallery-image-wrap">
            <img src={project.image_url || '/assets/images/placeholder.jpg'} alt={project.title} class="gallery-image" loading="lazy" />
          </div>
          <h3>{project.title}</h3>
          <p>{project.category || 'Graphic Design'}</p>
        </a>
      ))}
      {projects.length === 0 && (
        <p style="color: var(--text-muted); grid-column: 1/-1;">No projects added yet.</p>
      )}
    </div>
  </section>
</Layout>
