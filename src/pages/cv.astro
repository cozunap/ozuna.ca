---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CV & About | Carlos Ozuna">
  <div class="container section">
    <div style="display: grid; grid-template-columns: 1fr; gap: 4rem; align-items: start;">
      
      <div>
        <h1 class="title-giant">Carlos Ozuna</h1>
        <p class="subtitle" style="color: var(--navy); font-size: 1.5rem;">Senior Graphic Designer & Web Developer</p>
        
        <p style="font-size: 1.125rem; margin-bottom: 2rem; max-width: 800px; color: var(--text-muted);">
          I specialize in building premium brand identities and digital experiences. With extensive knowledge of the Adobe Creative Suite and modern web technologies, I deliver scalable, beautiful solutions that drive results.
        </p>

        <a href="/carlos-ozuna-cv.pdf" download class="btn btn-gold" style="margin-bottom: 4rem;">
          <svg style="width: 20px; height: 20px; margin-right: 8px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Download Full CV (PDF)
        </a>
      </div>

      <div class="cv-box">
        <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem;">Core Expertise</h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
          <div>
            <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem; font-family: 'Inter', sans-serif;">Design</h3>
            <ul style="list-style: none; color: var(--text-muted); line-height: 2;">
              <li>Brand Identity</li>
              <li>UI/UX Design</li>
              <li>Typography</li>
              <li>Prototyping (Figma)</li>
            </ul>
          </div>
          <div>
            <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem; font-family: 'Inter', sans-serif;">Development</h3>
            <ul style="list-style: none; color: var(--text-muted); line-height: 2;">
              <li>Astro / React</li>
              <li>HTML / CSS (Tailwind)</li>
              <li>Static Site Generation</li>
              <li>Performance Optimization</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
