---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

let projects = [];
try {
  projects = await getCollection('work');
} catch (e) {}
---
<Layout title="Portfolio | Carlos Ozuna">
  <div class="container section">
    <h1 class="title-giant">Portfolio</h1>
    <p class="subtitle">A curated gallery of my latest graphic design, branding, and web development projects.</p>
    
    <div class="gallery-grid">
      {projects.map((project) => (
        <a href={`/work/${project.slug}`} class="gallery-card">
          <div class="gallery-image-wrap">
            <img src={project.data.image || project.data.coverImage || '/assets/images/placeholder.jpg'} alt={project.data.title} class="gallery-image" />
          </div>
          <h3>{project.data.title}</h3>
          <p>{project.data.category || 'Graphic Design'}</p>
        </a>
      ))}
      {projects.length === 0 && (
        <p style="color: var(--text-muted); grid-column: 1/-1;">No projects added yet.</p>
      )}
    </div>
  </div>
</Layout>
