---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlocksRenderer from '../components/blocks/BlocksRenderer.astro';

const homeEntry = await getEntry('pages', 'home');
const { title, meta_description, blocks } = homeEntry.data;
---

<Layout title={title} description={meta_description}>
  {blocks && <BlocksRenderer blocks={blocks} />}
</Layout>
