---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlocksRenderer from '../components/blocks/BlocksRenderer.astro';

const contactEntry = await getEntry('pages', 'contact');
const { title, meta_description, blocks } = contactEntry.data;
---

<Layout title={title} description={meta_description} headerClass="solid-bg">
  <div class="page-section">
    {blocks && <BlocksRenderer blocks={blocks} />}
  </div>
</Layout>
