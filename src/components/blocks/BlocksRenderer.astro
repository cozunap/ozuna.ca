---
import HeroBlock from './HeroBlock.astro';
import TextBlock from './TextBlock.astro';
import GalleryBlock from './GalleryBlock.astro';
import TestimonialBlock from './TestimonialBlock.astro';

const { blocks } = Astro.props;
---

{blocks && blocks.map((block: any) => {
  const type = block.type || block._template;
  if (type === 'hero') return <HeroBlock block={block} />
  if (type === 'text') return <TextBlock block={block} />
  if (type === 'gallery') return <GalleryBlock block={block} />
  if (type === 'testimonial') return <TestimonialBlock block={block} />
  return null;
})}
