---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlocksRenderer from '../components/blocks/BlocksRenderer.astro';

export async function getStaticPaths() {
  const workEntries = await getCollection('work');
  return workEntries.map(entry => {
    const slug = entry.slug || (entry.id ? entry.id.replace(/\.[^/.]+$/, '') : null);
    return {
      params: { slug },
      props: { entry },
    };
  }).filter(route => route.params.slug);
}

const { entry } = Astro.props;
const { title, meta_description, blocks } = entry.data || {};
---

<Layout title={`${title} | Carlos Ozuna`} description={meta_description} headerClass="solid-bg">
  <div class="page-section">
    <h1 class="page-title text-center text-huge stroke-text">{title}</h1>
    {blocks && <BlocksRenderer blocks={blocks} />}
  </div>
</Layout>
