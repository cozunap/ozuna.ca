datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default("global-settings")
  title       String
  description String
  colorsJson  String
  heroVideo   String
  updatedAt   DateTime @updatedAt
}

model Page {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  metaDescription String
  sectionsJson    String
  updatedAt       DateTime @updatedAt
}

model PortfolioItem {
  id          String   @id @default(uuid())
  title       String
  category    String
  slug        String   @unique
  image       String
  description String?
  client      String?
  year        String?
  link        String?
  order       Int      @default(0)
  featured    Boolean  @default(true)
  galleryJson String?
  displayType String?  @default("gallery")
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  payload   String?
  createdAt DateTime @default(now())
}
