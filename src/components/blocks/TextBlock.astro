---
import { marked } from 'marked';
const { block } = Astro.props;

// Render markdown content to HTML
const htmlContent = block.content ? marked.parse(block.content) : '';
---

<section class="block-text container">
  <div class="content-wrapper" set:html={htmlContent}></div>
</section>

<style>
  .block-text {
    padding: clamp(4rem, 8vw, 7rem) 0;
    max-width: 800px;
    margin: 0 auto;
  }
  .content-wrapper {
    color: var(--text-dark);
  }
</style>
