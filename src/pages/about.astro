---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

let aboutData = {
  intro: "Hi there! I'm a graphic designer with 20+ years of experience...",
  cvFile: "/carlos-ozuna-cv.pdf",
  whatIBring: [
    "Mastery of Adobe tools...",
    "A deep understanding of print and digital design...",
    "A humble, team-first mindset.",
    "Fluent communication in English, French, and Spanish..."
  ]
};
let Content = null;

try {
  const entry = await getEntry('pages', 'about');
  if (entry) {
    aboutData = entry.data;
    const rendered = await render(entry);
    Content = rendered.Content;
  }
} catch (e) {}
---
<Layout title="About | Carlos Ozuna">
    <section class="about-hero" style="position: relative; padding: 8rem 0; margin-bottom: 4rem; background-image: url('/assets/images/portfolio-header-bg.webp'); background-size: cover; background-position: center top;">
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 1;"></div>
    <div class="container" style="position: relative; z-index: 2; text-align: center;">
      <h1 class="title-giant text-white" style="margin-bottom: 1rem;">About</h1>
      <p class="subtitle text-white" style="margin: 0 auto; opacity: 0.9;">A little bit about who I am and what I do.</p>
    </div>
  </section>

  <div class="container" style="max-width: 800px; margin: 0 auto; font-size: 1.125rem; color: var(--navy); line-height: 1.8; text-align: center;">
    
    <h3 style="font-family: 'Inter', sans-serif; font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">Let's Create Something Great Together</h3>
    <p style="margin-bottom: 2.5rem;">{aboutData.intro}</p>

    

    
    {Content ? (
      <div style="margin-bottom: 5rem; text-align: center;">
        <Content />
      </div>
    ) : (
      <p style="margin-bottom: 5rem;">Loading content...</p>
    )}
  </div>

  <div class="section-sm" style="background: #f1f5f9; text-align: center; border-top: 1px solid #e2e8f0;">
    <div class="container">
      <h2 style="font-size: 2.5rem; margin-bottom: 2rem;">Contact Carlos Ozuna</h2>
      
      <div style="display: flex; flex-direction: column; gap: 1rem; align-items: center; max-width: 300px; margin: 0 auto;">
        <a href={aboutData.cvFile || "/carlos-ozuna-cv.pdf"} download class="btn btn-outline" style="width: 100%; border-color: var(--navy);">Download My CV</a>
        <a href="/work" class="btn btn-outline" style="width: 100%; border-color: var(--navy);">See Carlos Ozuna's Work</a>
        <a href="mailto:contact@ozuna.ca" class="btn btn-gold" style="width: 100%;">Contact Me</a>
      </div>
    </div>
  </div>
</Layout>
